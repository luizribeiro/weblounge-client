{
  "name": "@weblounge/app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm assets && tsc --noEmit && vite build && node scripts/verify-production-build.mjs",
    "dev": "pnpm assets && vite",
    "assets": "pnpm icons && pnpm startup-images",
    "e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "startup-images": "node scripts/generate-startup-images.mjs",
    "test": "vitest run && node --test e2e/socket-forwarder.test.mjs e2e/self-signed-certificate.test.mjs e2e/socket-forwarder-scope.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/solid-virtual": "3.13.48",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@babel/parser": "7.29.11",
    "@playwright/test": "1.64.1",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "24.10.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5"
  }
}
