{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "weblounge dev",
  "version": "0.1.3",
  "identifier": "org.weblounge.desktop.dev",
  "build": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "remote-page",
          "description": "Lets the hosted app set the Dock badge, use the system notification center, drag and zoom the window from its chrome, read whether it is full screen, and match the window's theme and background to the page on macOS, and nothing else.",
          "platforms": [
            "macOS"
          ],
          "windows": [
            "main"
          ],
          "remote": {
            "urls": [
              "https://beta.weblounge.org/*"
            ]
          },
          "permissions": [
            "core:window:allow-set-badge-count",
            "allow-notification-permission",
            "allow-request-notification-permission",
            "allow-post-notification",
            "allow-close-notification",
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize",
            "core:window:allow-is-fullscreen",
            "core:window:allow-set-theme",
            "core:window:allow-set-background-color",
            "core:webview:allow-set-webview-background-color"
          ]
        },
        {
          "identifier": "remote-page-ios",
          "description": "Lets the hosted app register for APNs, keep its push route keys where the notification extension can read them, and manage the badge and delivered notifications on iOS, and nothing else.",
          "platforms": [
            "iOS"
          ],
          "windows": [
            "main"
          ],
          "remote": {
            "urls": [
              "https://beta.weblounge.org/*"
            ]
          },
          "permissions": [
            "allow-push-permission",
            "allow-request-push-permission",
            "allow-push-target",
            "allow-create-route-keys",
            "allow-drop-route-keys",
            "allow-routes-needing-reregistration",
            "allow-take-pushed-messages",
            "allow-set-badge",
            "allow-write-notification-counts",
            "allow-delivered-notifications",
            "allow-remove-delivered-notifications"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "SocialNetworking",
    "icon": [
      "icons-dev/32x32.png",
      "icons-dev/128x128.png",
      "icons-dev/128x128@2x.png",
      "icons-dev/icon.icns",
      "icons-dev/icon.ico"
    ]
  }
}
