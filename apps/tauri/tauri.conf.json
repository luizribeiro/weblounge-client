{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "weblounge",
  "version": "0.1.1",
  "identifier": "org.weblounge.desktop",
  "build": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "remote-page",
          "description": "Lets the hosted app set the Dock badge and use the system notification center, and nothing else.",
          "windows": [
            "main"
          ],
          "remote": {
            "urls": [
              "https://beta.weblounge.org/*"
            ]
          },
          "permissions": [
            "core:window:allow-set-badge-count",
            "allow-notification-permission",
            "allow-request-notification-permission",
            "allow-post-notification",
            "allow-close-notification"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
